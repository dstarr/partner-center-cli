# Copy to .env and fill in.

# App registration used by the AuthManager to sign in with the client credentials grant.
PARTNER_CENTER_TENANT_ID=
PARTNER_CENTER_CLIENT_ID=
PARTNER_CENTER_CLIENT_SECRET=

# Product Ingestion API base URL, including its path. Defaults to this value when blank.
PRODUCT_INGESTION_BASE_URL=https://graph.microsoft.com/rp/product-ingestion

# Schema base URL, including its path. Defaults to this value when blank.
SCHEMA_BASE_URL=https://schema.mp.microsoft.com/schema
